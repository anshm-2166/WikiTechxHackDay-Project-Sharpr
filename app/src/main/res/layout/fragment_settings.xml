<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:overScrollMode="never"
    android:paddingBottom="140dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textAppearance="@style/TextAppearance.S.Display" />

        <!-- Appearance -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="8dp"
            android:text="Appearance"
            android:textAppearance="@style/TextAppearance.S.Section" />

        <LinearLayout
            style="@style/Sharpr.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Theme"
                android:textAppearance="@style/TextAppearance.S.Label" />

            <com.vytros.projects.sharpr.ui.widgets.SegmentedControl
                android:id="@+id/theme_seg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <com.vytros.projects.sharpr.ui.widgets.SwitchRow
                android:id="@+id/amoled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:subtitle="True black surfaces in dark mode"
                app:title="AMOLED black" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Accent"
                android:textAppearance="@style/TextAppearance.S.Label" />

            <LinearLayout
                android:id="@+id/accent_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Font"
                android:textAppearance="@style/TextAppearance.S.Label" />

            <LinearLayout
                android:id="@+id/font_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal" />
        </LinearLayout>

        <!-- Engine -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:text="Inference engine"
            android:textAppearance="@style/TextAppearance.S.Section" />

        <LinearLayout
            style="@style/Sharpr.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/gpu_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_banner_info"
                android:drawableStart="@drawable/ic_chip"
                android:drawablePadding="12dp"
                android:drawableTint="?attr/sPrimary"
                android:gravity="center_vertical"
                android:padding="14dp"
                android:text="Detecting Vulkan GPU…"
                android:textAppearance="@style/TextAppearance.S.Body"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Run on"
                android:textAppearance="@style/TextAppearance.S.Label" />

            <com.vytros.projects.sharpr.ui.widgets.SegmentedControl
                android:id="@+id/engine_seg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/engine_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="8dp"
                android:textAppearance="@style/TextAppearance.S.Caption" />

            <com.vytros.projects.sharpr.ui.widgets.SwitchRow
                android:id="@+id/fallback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:subtitle="If the GPU fails mid-job, finish on the CPU"
                app:title="Fall back to CPU" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="CPU threads"
                android:textAppearance="@style/TextAppearance.S.Label" />

            <com.vytros.projects.sharpr.ui.widgets.SegmentedControl
                android:id="@+id/threads_seg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Tile size"
                android:textAppearance="@style/TextAppearance.S.Label" />

            <com.vytros.projects.sharpr.ui.widgets.SegmentedControl
                android:id="@+id/tile_seg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="8dp"
                android:text="Smaller tiles use less memory; larger ones are a little faster."
                android:textAppearance="@style/TextAppearance.S.Caption" />

            <com.vytros.projects.sharpr.ui.widgets.SwitchRow
                android:id="@+id/fp16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:subtitle="Half-precision storage. Faster and lighter; turn off if you see artefacts"
                app:title="FP16" />
        </LinearLayout>

        <!-- Defaults -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:text="Defaults"
            android:textAppearance="@style/TextAppearance.S.Section" />

        <LinearLayout
            style="@style/Sharpr.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Model"
                android:textAppearance="@style/TextAppearance.S.Label" />

            <com.vytros.projects.sharpr.ui.widgets.SegmentedControl
                android:id="@+id/def_model_seg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Scale"
                android:textAppearance="@style/TextAppearance.S.Label" />

            <com.vytros.projects.sharpr.ui.widgets.SegmentedControl
                android:id="@+id/def_scale_seg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Guards -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:text="Guards"
            android:textAppearance="@style/TextAppearance.S.Section" />

        <LinearLayout
            style="@style/Sharpr.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Count as high-res from (longest side, px)"
                android:textAppearance="@style/TextAppearance.S.Label" />

            <com.vytros.projects.sharpr.ui.widgets.SegmentedControl
                android:id="@+id/max_input_seg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <com.vytros.projects.sharpr.ui.widgets.SwitchRow
                android:id="@+id/strict"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:subtitle="Images that are large AND already sharp can't be forced through. Soft large photos are never blocked"
                app:title="Strict guard" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Maximum output size (megapixels)"
                android:textAppearance="@style/TextAppearance.S.Label" />

            <com.vytros.projects.sharpr.ui.widgets.SegmentedControl
                android:id="@+id/max_out_seg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="8dp"
                android:text="Sharpr lowers the scale automatically to stay under this. Higher limits need more RAM."
                android:textAppearance="@style/TextAppearance.S.Caption" />
        </LinearLayout>

        <!-- Output -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:text="Output"
            android:textAppearance="@style/TextAppearance.S.Section" />

        <LinearLayout
            style="@style/Sharpr.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Format"
                android:textAppearance="@style/TextAppearance.S.Label" />

            <com.vytros.projects.sharpr.ui.widgets.SegmentedControl
                android:id="@+id/format_seg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <com.vytros.projects.sharpr.ui.widgets.LabeledSlider
                android:id="@+id/quality"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:label="JPEG / WebP quality"
                app:suffix="" />
        </LinearLayout>

        <!-- Storage -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:text="Storage"
            android:textAppearance="@style/TextAppearance.S.Section" />

        <LinearLayout
            style="@style/Sharpr.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/storage_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.S.Muted" />

            <Button
                android:id="@+id/clear_btn"
                style="@style/Sharpr.Button.Danger"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Clear library" />
        </LinearLayout>

        <TextView
            android:id="@+id/about"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.S.Caption" />
    </LinearLayout>
</ScrollView>
