<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background" android:gravity="center_vertical">
        <shape android:shape="rectangle">
            <size android:height="6dp" />
            <solid android:color="?attr/sOutline" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress" android:gravity="center_vertical">
        <clip>
            <shape android:shape="rectangle">
                <size android:height="6dp" />
                <gradient android:angle="0" android:startColor="?attr/sPrimary" android:endColor="?attr/sGradEnd" />
                <corners android:radius="3dp" />
            </shape>
        </clip>
    </item>
</layer-list>

